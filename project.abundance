          "name": "A",
          "ioValue": "__GEOMETRY_INPUT__"
        }
      ],
      "interpreterVersion": 1,
      "code": "/**\n * Recenters geometry input \"A\" in the XY plane based on its bounding box.\n * Z is left unchanged.\n */\nfunction run(A: Assembly) {\n  if (!A) {\n    // Nothing to do if no input provided\n    return null;\n  }\n\n  const total = A.leafCount();\n\n  // Pass 1: accumulate the XY bounding box across every part of A.\n  let minX = Infinity;\n  let minY = Infinity;\n  let maxX = -Infinity;\n  let maxY = -Infinity;\n  let measured = 0;\n  A.onLeafs((leaf) => {\n    progress(`measuring part ${++measured}/${total}`);\n    // bounds is [[minX, minY, (minZ)], [maxX, maxY, (maxZ)]] for both 3D\n    // shapes and 2D drawings.\n    const [min, max] = leaf.geometry.boundingBox.bounds;\n    minX = Math.min(minX, min[0]);\n    minY = Math.min(minY, min[1]);\n    maxX = Math.max(maxX, max[0]);\n    maxY = Math.max(maxY, max[1]);\n    return leaf;\n  });\n\n  // Translation that moves the bounding box center to the origin in XY.\n  const dx = -(minX + maxX) / 2;\n  const dy = -(minY + maxY) / 2;\n\n  // Pass 2: move every part by the same offset.\n  let moved = 0;\n  return A.onLeafs((leaf) => {\n    progress(`moving part ${++moved}/${total}`);\n    const geometry = leaf.is2D()\n      ? leaf.geometry.clone().translate(dx, dy)\n      : leaf.geometry.clone().translate(dx, dy, 0);\n    return new Assembly({ ...leaf, geometry });\n  });\n}",
      "compiledCode": "\"use strict\";\n/**\n * Recenters geometry input \"A\" in the XY plane based on its bounding box.\n * Z is left unchanged.\n */\nfunction run(A) {\n    if (!A) {\n        // Nothing to do if no input provided\n        return null;\n    }\n    const total = A.leafCount();\n    // Pass 1: accumulate the XY bounding box across every part of A.\n    let minX = Infinity;\n    let minY = Infinity;\n    let maxX = -Infinity;\n    let maxY = -Infinity;\n    let measured = 0;\n    A.onLeafs((leaf) => {\n        progress(`measuring part ${++measured}/${total}`);\n        // bounds is [[minX, minY, (minZ)], [maxX, maxY, (maxZ)]] for both 3D\n        // shapes and 2D drawings.\n        const [min, max] = leaf.geometry.boundingBox.bounds;\n        minX = Math.min(minX, min[0]);\n        minY = Math.min(minY, min[1]);\n        maxX = Math.max(maxX, max[0]);\n        maxY = Math.max(maxY, max[1]);\n        return leaf;\n    });\n    // Translation that moves the bounding box center to the origin in XY.\n    const dx = -(minX + maxX) / 2;\n    const dy = -(minY + maxY) / 2;\n    // Pass 2: move every part by the same offset.\n    let moved = 0;\n    return A.onLeafs((leaf) => {\n        progress(`moving part ${++moved}/${total}`);\n        const geometry = leaf.is2D()\n            ? leaf.geometry.clone().translate(dx, dy)\n            : leaf.geometry.clone().translate(dx, dy, 0);\n        return new Assembly({ ...leaf, geometry });\n    });\n}\n"
    },
